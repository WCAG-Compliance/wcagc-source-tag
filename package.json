{
  "name": "@wcagc/source-tag",
  "version": "1.1.1",
  "description": "Deterministic JSX source attributes for wcagc browser checks",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WCAG-Compliance/wcagc-source-tag.git"
  },
  "homepage": "https://github.com/WCAG-Compliance/wcagc-source-tag#readme",
  "bugs": "https://github.com/WCAG-Compliance/wcagc-source-tag/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "magic-string": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "vite": ">=5 <9"
  },
  "engines": {
    "node": ">=20"
  }
}
